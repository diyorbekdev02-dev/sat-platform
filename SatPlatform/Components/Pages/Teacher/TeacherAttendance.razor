@page "/teacher/attendance"
@attribute [Authorize(Roles = "Teacher,Assistant,Admin,SuperAdmin")]
@inherits AppPage
@inject AcademyService Academy

<PageTitle>Davomat</PageTitle>

@if (Loading) { <div class="loading"><span class="spinner"></span></div> }
else
{
    <div class="card mb">
        <div class="form-row">
            <div><label class="lbl">Guruh</label><select class="input" @bind="groupId" @bind:after="LoadAsync"><option value="0">— tanlang —</option>@foreach (var g in groups) { <option value="@g.Id">@g.Name</option> }</select></div>
            <div><label class="lbl">Oy</label><input class="input" type="month" value="@monthText" @onchange="OnMonth" /></div>
        </div>
    </div>
    @if (group is not null)
    {
        <div class="card">
            <div class="row between mb">
                <div><h2>@group.Name</h2><div class="small muted">@rows.Count o'quvchi · @days.Count ta dars</div></div>
                <div class="row"><button class="btn primary" @onclick="SaveAsync" disabled="@(busy || dirty.Count == 0)"><Icon Name="check" /> Saqlash@(dirty.Count > 0 ? $" ({dirty.Count})" : "")</button></div>
            </div>
            @if (rows.Count == 0) { <div class="empty"><h3>Guruhda o'quvchi yo'q</h3></div> }
            else if (days.Count == 0) { <div class="empty"><h3>Bu oyda dars yo'q</h3><p>Guruh jadvali (dars kunlari) kiritilmagan.</p></div> }
            else
            {
                <div class="att-grid-wrap">
                    <table class="att-grid">
                        <thead>
                            <tr>
                                <th class="nm">Ism</th>
                                @for (var i = 0; i < days.Count; i++)
                                {
                                    var d = days[i];
                                    <th class="@(d == Tz.Today ? "today" : "")"><button class="att-all" title="Shu kun: hammasi keldi" @onclick="() => SetDay(d)"><span class="lesson">@(i + 1)-dars</span>@d.ToString("dd.MM")</button></th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @for (var n = 0; n < rows.Count; n++)
                            {
                                var r = rows[n];
                                <tr>
                                    <td class="nm"><b>@r.Name</b></td>
                                    @foreach (var d in days)
                                    {
                                        AttendanceStatus? s = r.Cells.TryGetValue(d, out var v) ? v : null;
                                        <td class="att-td">
                                            <button class="att-cell @Css(s) @(dirty.Contains((r.StudentId, d)) ? "dirty" : "")" title="@Label(s)" @onclick="() => Toggle(r.StudentId, d)">@Glyph(s)</button>
                                            @if (open == (r.StudentId, d))
                                            {
                                                <div class="att-backdrop" @onclick="() => open = null"></div>
                                                <div class="att-menu @(n >= rows.Count - 2 && rows.Count > 3 ? "up" : "")">
                                                    @foreach (var o in Order)
                                                    {
                                                        <button class="@(s == o ? "sel" : "")" @onclick="() => Pick(r, d, o)"><i class="att-dot @Css(o)"></i>@Label(o)</button>
                                                    }
                                                </div>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="att-legend small muted mt-s">
                    <span><i class="att-cell present">✓</i> Keldi</span><span><i class="att-cell absent">✕</i> Sababsiz</span><span><i class="att-cell late">K</i> Kechikdi</span><span><i class="att-cell excused">S</i> Sababli</span><span><i class="att-cell"></i> Belgilanmagan</span>
                </div>
            }
        </div>
    }
}

@code {
    [SupplyParameterFromQuery(Name = "group")] public int? QGroup { get; set; }
    private List<Group> groups = [];
    private Group? group;
    private int groupId;
    private string monthText = Tz.Today.ToString("yyyy-MM");
    private bool busy;
    private class Row { public int StudentId; public string Name = ""; public Dictionary<DateOnly, AttendanceStatus> Cells = []; public Dictionary<DateOnly, int> Late = []; }
    private List<Row> rows = [];
    private List<DateOnly> days = [];
    private HashSet<(int, DateOnly)> dirty = [];

    protected override async Task OnInitializedAsync()
    {
        SetTitle("Davomat");
        var uid = await Me.IdAsync(); var role = (await Me.RoleAsync())!.Value;
        groups = await Academy.GroupsAsync(await Academy.GroupScopeAsync(uid, role));
        groupId = QGroup ?? (groups.FirstOrDefault(g => AcademyService.HasClassOn(g, Tz.Today))?.Id ?? groups.FirstOrDefault()?.Id ?? 0);
        await LoadAsync();
        Loading = false;
    }

    private async Task OnMonth(ChangeEventArgs e) { monthText = e.Value?.ToString() ?? monthText; await LoadAsync(); }

    private async Task LoadAsync()
    {
        dirty.Clear();
        group = groups.FirstOrDefault(g => g.Id == groupId);
        if (group is null) { rows = []; days = []; return; }
        if (!DateOnly.TryParse(monthText + "-01", out var first)) { first = new DateOnly(Tz.Today.Year, Tz.Today.Month, 1); monthText = first.ToString("yyyy-MM"); }
        var last = first.AddMonths(1).AddDays(-1);
        var full = await Academy.GroupAsync(groupId);
        var existing = await Academy.AttendanceRangeAsync(groupId, first, last);
        // class days by schedule, plus any day that already has a record
        days = Enumerable.Range(0, last.Day).Select(i => first.AddDays(i))
            .Where(d => AcademyService.HasClassOn(group, d) || existing.Any(a => a.Date == d)).ToList();
        rows = full!.Enrollments.Where(e => e.Status == EnrollmentStatus.Active).OrderBy(e => e.Student.User.FullName).Select(e => new Row
        {
            StudentId = e.StudentId,
            Name = e.Student.User.FullName,
            Cells = existing.Where(a => a.StudentId == e.StudentId).ToDictionary(a => a.Date, a => a.Status),
            Late = existing.Where(a => a.StudentId == e.StudentId && a.LateMinutes > 0).ToDictionary(a => a.Date, a => a.LateMinutes)
        }).ToList();
    }

    private static readonly AttendanceStatus[] Order = [AttendanceStatus.Present, AttendanceStatus.Absent, AttendanceStatus.Late, AttendanceStatus.Excused];

    private (int, DateOnly)? open;

    private void Toggle(int studentId, DateOnly d) => open = open == (studentId, d) ? null : (studentId, d);

    private void Pick(Row r, DateOnly d, AttendanceStatus s)
    {
        if (!r.Cells.TryGetValue(d, out var cur) || cur != s) { r.Cells[d] = s; dirty.Add((r.StudentId, d)); }
        open = null;
    }

    private void SetDay(DateOnly d) { foreach (var r in rows) { r.Cells[d] = AttendanceStatus.Present; dirty.Add((r.StudentId, d)); } }

    private async Task SaveAsync()
    {
        busy = true;
        var uid = await Me.IdAsync();
        foreach (var byDate in dirty.GroupBy(x => x.Item2))
        {
            var batch = byDate.Select(x => { var r = rows.First(r => r.StudentId == x.Item1); return (r.StudentId, r.Cells[byDate.Key], r.Late.TryGetValue(byDate.Key, out var m) ? m : 10); }).ToList();
            await Academy.SaveAttendanceAsync(groupId, byDate.Key, batch, uid);
        }
        dirty.Clear();
        busy = false;
        Toasts.Ok("Davomat saqlandi");
    }

    private static string Css(AttendanceStatus? s) => s switch { AttendanceStatus.Present => "present", AttendanceStatus.Absent => "absent", AttendanceStatus.Late => "late", AttendanceStatus.Excused => "excused", _ => "" };
    private static string Glyph(AttendanceStatus? s) => s switch { AttendanceStatus.Present => "✓", AttendanceStatus.Absent => "✕", AttendanceStatus.Late => "K", AttendanceStatus.Excused => "S", _ => "" };
    private static string Label(AttendanceStatus? s) => s switch { AttendanceStatus.Present => "Keldi", AttendanceStatus.Absent => "Sababsiz", AttendanceStatus.Late => "Kechikdi", AttendanceStatus.Excused => "Sababli", _ => "Belgilanmagan" };
}
