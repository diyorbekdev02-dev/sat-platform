@page "/help"
@attribute [Authorize]
@inherits AppPage

<PageTitle>Qo'llanma</PageTitle>

<div class="row between mb">
    <div class="muted small">@manual.Intro</div>
    <div class="row">
        <a class="btn primary" href="@pdfUrl" download="SAT-Platform-qollanma-@(slug).pdf"><Icon Name="download" /> PDF yuklab olish</a>
        <a class="btn" href="@pdfUrl" target="_blank"><Icon Name="external" /> Yangi oynada ochish</a>
    </div>
</div>

<div class="grid c4 mb">
    @foreach (var tip in manual.Tips)
    {
        <div class="card"><div class="row"><Icon Name="@tip.Icon" /><b>@tip.Title</b></div><div class="small muted mt-s">@tip.Text</div></div>
    }
</div>

<div class="card pad-0" style="height:78vh">
    <iframe src="@pdfUrl#toolbar=1&view=FitH" title="Qo'llanma" style="width:100%;height:100%;border:none"></iframe>
</div>

@code {
    private Manual manual = null!;
    private string slug = "", pdfUrl = "";

    protected override async Task OnInitializedAsync()
    {
        SetTitle("Qo'llanma");
        var role = await Me.RoleAsync();
        (manual, slug, pdfUrl) = (PageHelp.ManualFor(role), PageHelp.Slug(role), PageHelp.PdfUrl(role));
    }
}
