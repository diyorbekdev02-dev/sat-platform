@page "/admin/users"
@attribute [Authorize(Roles = "Admin,SuperAdmin")]
@inherits AppPage
@inject AcademyService Academy

<PageTitle>Xodimlar va ota-onalar</PageTitle>

@if (Loading) { <div class="loading"><span class="spinner"></span></div> }
else
{
    <div class="row between mb">
        <div class="row">
            <input class="input sm" style="width:240px" placeholder="Ism yoki telefon" @bind="search" @bind:event="oninput" @bind:after="LoadAsync" />
            <div class="chips">@foreach (var r in new[] { UserRole.Teacher, UserRole.Assistant, UserRole.Parent, UserRole.Admin, UserRole.SuperAdmin }) { <button class="chip @(role == r ? "active" : "")" @onclick="() => { role = role == r ? null : r; _ = LoadAsync(); }">@Labels.Role(r)</button> }</div>
        </div>
        <button class="btn primary" @onclick="() => Open(null)"><Icon Name="plus" /> Foydalanuvchi qo'shish</button>
    </div>
    <div class="card pad-0"><div class="table-wrap"><table class="table">
        <thead><tr><th>Ism</th><th>Telefon</th><th>Rol</th><th>Guruhlar</th><th>Telegram</th><th>Holat</th><th>Oxirgi kirish</th><th></th></tr></thead>
        <tbody>@foreach (var u in users)
        {
            <tr><td class="bold">@u.FullName<div class="tiny muted">@u.Email</div></td><td><PhoneLink Value="@u.Phone" /></td><td><span class="badge">@Labels.Role(u.Role)</span>@if (u.CanManageQuestions) { <span class="badge accent">savollar</span> }</td><td>@u.GroupCount</td><td>@(u.Telegram ? "✓" : "—")</td><td><span class="badge @(u.IsActive ? "ok" : "danger")">@(u.IsActive ? "Faol" : "O'chirilgan")</span></td><td>@Tz.Fmt(u.LastSeenAt)</td><td><button class="btn sm" @onclick="() => Open(u)"><Icon Name="pencil" Size="14" /></button></td></tr>
        }</tbody></table></div>@if (users.Count == 0) { <div class="empty"><h3>Topilmadi</h3></div> }</div>

    <Modal Open="editOpen" OpenChanged="v => editOpen = v" Title="@(editId == 0 ? "Yangi foydalanuvchi" : "Foydalanuvchini tahrirlash")">
        <label class="lbl">Ism-familiya</label><input class="input" @bind="eName" />
        <label class="lbl">Telefon</label><input class="input" type="tel" inputmode="tel" data-phone placeholder="+998 90 123 45 67" @bind="ePhone" />
        <label class="lbl">Email</label><input class="input" @bind="eEmail" />
        <label class="lbl">Rol</label>
        <select class="input" @bind="eRole">@foreach (var r in new[] { UserRole.Teacher, UserRole.Assistant, UserRole.Parent, UserRole.Admin, UserRole.SuperAdmin }) { <option value="@r">@Labels.Role(r)</option> }</select>
        @if (eRole == UserRole.Teacher) { <label class="check mt-s"><input type="checkbox" @bind="eCanManage" /> Savollar bankiga ruxsat (yaratish, tahrirlash)</label> }
        <label class="lbl">@(editId == 0 ? "Parol" : "Yangi parol (bo'sh = o'zgarmaydi)")</label><input class="input" @bind="ePassword" />
        @if (editId > 0) { <label class="check mt-s"><input type="checkbox" @bind="eActive" /> Hisob faol</label> }
        @if (Error is not null) { <div class="error">@Error</div> }
        <div class="modal-actions"><button class="btn" @onclick="() => editOpen = false">Bekor</button><button class="btn primary" @onclick="SaveAsync" disabled="@busy">Saqlash</button></div>
    </Modal>
}

@code {
    private List<UserRow> users = [];
    private UserRole? role;
    private string search = "";
    private bool editOpen, busy, eCanManage, eActive = true;
    private int editId;
    private string eName = "", ePhone = "+998 ", eEmail = "", ePassword = "";
    private UserRole eRole = UserRole.Teacher;

    protected override async Task OnInitializedAsync() { SetTitle("Xodimlar va ota-onalar"); await LoadAsync(); Loading = false; }
    private async Task LoadAsync() { users = (await Academy.UsersAsync(role, search)).Where(u => u.Role != UserRole.Student).ToList(); }

    private void Open(UserRow? u)
    {
        Error = null; editOpen = true;
        if (u is null) { editId = 0; eName = ""; ePhone = "+998 "; eEmail = ""; ePassword = ""; eRole = UserRole.Teacher; eCanManage = false; eActive = true; }
        else { editId = u.Id; eName = u.FullName; ePhone = PhoneFormat.Display(u.Phone); eEmail = u.Email ?? ""; ePassword = ""; eRole = u.Role; eCanManage = u.CanManageQuestions; eActive = u.IsActive; }
    }

    private async Task SaveAsync()
    {
        busy = true; Error = null;
        var me = await Me.IdAsync();
        string? err;
        if (editId == 0) (_, err) = await Academy.CreateUserAsync(eName, ePhone, eRole, string.IsNullOrWhiteSpace(ePassword) ? null : ePassword, eEmail, null, me, eCanManage);
        else err = await Academy.UpdateUserAsync(editId, eName, ePhone, eEmail, eRole, eActive, eCanManage, string.IsNullOrWhiteSpace(ePassword) ? null : ePassword, me);
        busy = false;
        if (err is not null) { Error = err; return; }
        editOpen = false; Toasts.Ok("Saqlandi"); await LoadAsync();
    }
}
